DEFAULT_MACRO FME_PYTHON_VERSION 313
DEFAULT_MACRO WB_CURRENT_CONTEXT
READER_TYPE NULL
NULL_DATASET null
WRITER_TYPE NULL
NULL_DEST NULL

FACTORY_DEF * CreationFactory \
   FACTORY_NAME Creator_Creator \
   CREATE_AT_END Yes \
   OUTPUT FEATURE_TYPE Creator_CREATED

FACTORY_DEF * TeeFactory \
   FACTORY_NAME Setup_AI_Params \
   INPUT FEATURE_TYPE Creator_CREATED \
   OUTPUT FEATURE_TYPE Setup_AI_Params_OUTPUT \
   _ai_action "VALIDATE_AND_ENRICH" \
   sample_address "10 Rue de la Paix, 75002 Paris"

FACTORY_DEF {*} PythonFactory \
   FACTORY_NAME MCPConnector_Caller \
   FLUSH_WHEN_GROUPS_CHANGE No \
   INPUT FEATURE_TYPE Setup_AI_Params_OUTPUT \
   SYMBOL_NAME { MCPConnectorTransformer } \
   PYTHON_NAMESPACE FMEOBJECTS \
   SOURCE_CODE { #<space>MCPConnector<space>FME<space>Custom<space>Transformer<space>Script<lf>import<space>contextlib<lf>import<space>json<lf>import<space>socket<lf>import<space>sys<lf>import<space>time<lf><lf>try:<lf><space><space><space><space>import<space>fmeobjects<lf>except<space>ImportError:<lf><space><space><space><space>pass<lf><lf>class<space>MCPConnectorTransformer<openparen>object<closeparen>:<lf><space><space><space><space>def<space>__init__<openparen>self<closeparen>:<lf><space><space><space><space><space><space><space><space>self.host<space>=<space><apos>127.0.0.1<apos><lf><space><space><space><space><space><space><space><space>self.port<space>=<space>9877<lf><space><space><space><space><space><space><space><space>self.sock<space>=<space>None<lf><space><space><space><space><space><space><space><space>self.connected<space>=<space>False<lf><space><space><space><space><space><space><space><space>self._init_connection<openparen><closeparen><lf><lf><space><space><space><space>def<space>_init_connection<openparen>self<closeparen>:<lf><space><space><space><space><space><space><space><space>try:<lf><space><space><space><space><space><space><space><space><space><space><space><space>self.sock<space>=<space>socket.socket<openparen>socket.AF_INET<comma><space>socket.SOCK_STREAM<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>self.sock.settimeout<openparen>0.8<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>self.sock.connect<openparen><openparen>self.host<comma><space>self.port<closeparen><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>self.connected<space>=<space>True<lf><space><space><space><space><space><space><space><space>except<space>Exception:<lf><space><space><space><space><space><space><space><space><space><space><space><space>self.connected<space>=<space>False<lf><space><space><space><space><space><space><space><space><space><space><space><space>self.sock<space>=<space>None<lf><lf><space><space><space><space>def<space>input<openparen>self<comma><space>feature<closeparen>:<lf><space><space><space><space><space><space><space><space>action<space>=<space>feature.getAttribute<openparen><apos>_ai_action<apos><closeparen><space>or<space><apos>INSPECT<apos><lf><space><space><space><space><space><space><space><space>if<space>hasattr<openparen>feature<comma><space><apos>getFeatureType<apos><closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space>feature_type<space>=<space>feature.getFeatureType<openparen><closeparen><lf><space><space><space><space><space><space><space><space>else:<lf><space><space><space><space><space><space><space><space><space><space><space><space>feature_type<space>=<space>str<openparen>feature.getAttribute<openparen><apos>fme_feature_type<apos><closeparen><space>or<space><apos>Feature<apos><closeparen><lf><lf><space><space><space><space><space><space><space><space>attrs<space>=<space>{}<lf><space><space><space><space><space><space><space><space>if<space>hasattr<openparen>feature<comma><space><apos>getAllAttributeNames<apos><closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space>for<space>name<space>in<space>feature.getAllAttributeNames<openparen><closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>if<space>not<space>name.startswith<openparen><apos>fme_<apos><closeparen><space>and<space>not<space>name.startswith<openparen><apos>_mcp_<apos><closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>val<space>=<space>feature.getAttribute<openparen>name<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>if<space>val<space>is<space>not<space>None:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>attrs<openbracket>name<closebracket><space>=<space>str<openparen>val<closeparen><lf><lf><space><space><space><space><space><space><space><space>payload<space>=<space>{<lf><space><space><space><space><space><space><space><space><space><space><space><space><apos>action<apos>:<space>action<comma><lf><space><space><space><space><space><space><space><space><space><space><space><space><apos>feature_type<apos>:<space>feature_type<comma><lf><space><space><space><space><space><space><space><space><space><space><space><space><apos>attributes<apos>:<space>attrs<comma><lf><space><space><space><space><space><space><space><space><space><space><space><space><apos>timestamp<apos>:<space>time.time<openparen><closeparen><comma><lf><space><space><space><space><space><space><space><space>}<lf><lf><space><space><space><space><space><space><space><space>status<space>=<space><apos>STANDALONE_FME<apos><lf><space><space><space><space><space><space><space><space>resp<space>=<space><apos>Processed<space>via<space>FME<space>Embedded<space>Python<space><openparen>MCP<space>bridge<space>ready<space>on<space>port<space>9877<closeparen><apos><lf><lf><space><space><space><space><space><space><space><space>if<space>self.connected<space>and<space>self.sock:<lf><space><space><space><space><space><space><space><space><space><space><space><space>try:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>msg<space>=<space><openparen>json.dumps<openparen>payload<closeparen><space>+<space><apos><backslash>n<apos><closeparen>.encode<openparen><apos>utf-8<apos><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>self.sock.sendall<openparen>msg<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>status<space>=<space><apos>AI_CONNECTED<apos><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>resp<space>=<space><apos>Sent<space>to<space>AI<space>Agent<space>on<space>port<space><apos><space>+<space>str<openparen>self.port<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>except<space>Exception<space>as<space>err:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>status<space>=<space><apos>BRIDGE_ERROR:<space><apos><space>+<space>str<openparen>err<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>resp<space>=<space><apos>Bridge<space>socket<space>send<space>error<apos><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>self.connected<space>=<space>False<lf><lf><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_mcp_status<apos><comma><space>status<closeparen><lf><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_ai_action_used<apos><comma><space>action<closeparen><lf><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_ai_bridge_port<apos><comma><space>self.port<closeparen><lf><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_ai_response<apos><comma><space>resp<closeparen><lf><lf><space><space><space><space><space><space><space><space>if<space>hasattr<openparen>self<comma><space><apos>pyoutput<apos><closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space>self.pyoutput<openparen>feature<closeparen><lf><lf><space><space><space><space>def<space>close<openparen>self<closeparen>:<lf><space><space><space><space><space><space><space><space>if<space>self.sock:<lf><space><space><space><space><space><space><space><space><space><space><space><space>with<space>contextlib.suppress<openparen>Exception<closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>self.sock.close<openparen><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>self.sock<space>=<space>None<lf><space><space><space><space><space><space><space><space><space><space><space><space>self.connected<space>=<space>False<lf> } \
   OUTPUT { PYOUTPUT FEATURE_TYPE MCPConnector_OUTPUT }

FACTORY_DEF * TeeFactory \
   FACTORY_NAME FinalNuker \
   INPUT FEATURE_TYPE MCPConnector_OUTPUT
