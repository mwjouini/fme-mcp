# ============================================================================
DEFAULT_MACRO $(MCPConnector_WORKSPACE_NAME)_AI_ACTION INSPECT
DEFAULT_MACRO $(MCPConnector_WORKSPACE_NAME)_BRIDGE_PORT 9877
DEFAULT_MACRO WB_CURRENT_CONTEXT
DEFAULT_MACRO MCPConnector_WORKSPACE_NAME ""
INCLUDE [puts {MACRO WB_OLD_CONTEXT_$(MCPConnector_WORKSPACE_NAME) $(WB_CURRENT_CONTEXT)}; \
         puts {MACRO WB_CURRENT_CONTEXT $(MCPConnector_WORKSPACE_NAME)}]

FACTORY_DEF * TeeFactory \
   FACTORY_NAME "$(MCPConnector_WORKSPACE_NAME)_Input_Splitter" \
   INPUT FEATURE_TYPE "$(MCPConnector_WORKSPACE_NAME)_Input" \
   OUTPUT FEATURE_TYPE "$(MCPConnector_WORKSPACE_NAME)_Python_Input" \
   "@EvaluateExpression(ATTR_CREATE_EXPR_PROPAGATE_MISSING_FDIV_TYPED,_ai_action,$($(MCPConnector_WORKSPACE_NAME)_AI_ACTION),UTF8, FEATURE_TYPE)" \
   "@EvaluateExpression(ATTR_CREATE_EXPR_PROPAGATE_MISSING_FDIV_TYPED,_ai_bridge_port,$($(MCPConnector_WORKSPACE_NAME)_BRIDGE_PORT),UTF8, FEATURE_TYPE)"

FME_PYTHON_PATH "$(FME_MF_DIR)"

FACTORY_DEF * PythonFactory \
   FACTORY_NAME $(MCPConnector_WORKSPACE_NAME)_MCPConnector_Caller \
   INPUT FEATURE_TYPE "$(MCPConnector_WORKSPACE_NAME)_Python_Input" \
   SYMBOL_NAME MCPConnectorTransformer \
   PYTHON_NAMESPACE FMEOBJECTS \
   SOURCE_CODE #<space>MCPConnector<space>FME<space>Custom<space>Transformer<space>Script<lf>#<space>Runs<space>natively<space>inside<space>FME<space>Form<apos>s<space>embedded<space>Python.<space>Zero<space>external<space>setup.<lf>import<space>contextlib<lf>import<space>json<lf>import<space>socket<lf>import<space>sys<lf>import<space>time<lf><lf>try:<lf><space><space><space><space>import<space>fmeobjects<lf>except<space>ImportError:<lf><space><space><space><space>pass<lf><lf>class<space>MCPConnectorTransformer:<lf><space><space><space><space>def<space>__init__<openparen>self<closeparen>:<lf><space><space><space><space><space><space><space><space>self.host<space>=<space><quote>127.0.0.1<quote><lf><space><space><space><space><space><space><space><space>self.port<space>=<space>9877<lf><space><space><space><space><space><space><space><space>self.sock<space>=<space>None<lf><space><space><space><space><space><space><space><space>self.connected<space>=<space>False<lf><space><space><space><space><space><space><space><space>self._init_connection<openparen><closeparen><lf><lf><space><space><space><space>def<space>_init_connection<openparen>self<closeparen>:<lf><space><space><space><space><space><space><space><space>try:<lf><space><space><space><space><space><space><space><space><space><space><space><space>self.sock<space>=<space>socket.socket<openparen>socket.AF_INET<comma><space>socket.SOCK_STREAM<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>self.sock.settimeout<openparen>0.8<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>self.sock.connect<openparen><openparen>self.host<comma><space>self.port<closeparen><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>self.connected<space>=<space>True<lf><space><space><space><space><space><space><space><space>except<space>Exception:<lf><space><space><space><space><space><space><space><space><space><space><space><space>self.connected<space>=<space>False<lf><space><space><space><space><space><space><space><space><space><space><space><space>self.sock<space>=<space>None<lf><lf><space><space><space><space>def<space>input<openparen>self<comma><space>feature<closeparen>:<lf><space><space><space><space><space><space><space><space>action<space>=<space>feature.getAttribute<openparen><quote>_ai_action<quote><closeparen><space>or<space><quote>INSPECT<quote><lf><space><space><space><space><space><space><space><space>try:<lf><space><space><space><space><space><space><space><space><space><space><space><space>req_port<space>=<space>int<openparen>feature.getAttribute<openparen><quote>_ai_bridge_port<quote><closeparen><space>or<space>9877<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>if<space>req_port<space>!=<space>self.port:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>self.port<space>=<space>req_port<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>self._init_connection<openparen><closeparen><lf><space><space><space><space><space><space><space><space>except<space>Exception:<lf><space><space><space><space><space><space><space><space><space><space><space><space>pass<lf><lf><space><space><space><space><space><space><space><space>feature_type<space>=<space><openparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>feature.getFeatureType<openparen><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>if<space>hasattr<openparen>feature<comma><space><quote>getFeatureType<quote><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>else<space>str<openparen>feature.getAttribute<openparen><quote>fme_feature_type<quote><closeparen><space>or<space><quote>Feature<quote><closeparen><lf><space><space><space><space><space><space><space><space><closeparen><lf><lf><space><space><space><space><space><space><space><space>attrs<space>=<space><opencurly><closecurly><lf><space><space><space><space><space><space><space><space>if<space>hasattr<openparen>feature<comma><space><quote>getAllAttributeNames<quote><closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space>for<space>name<space>in<space>feature.getAllAttributeNames<openparen><closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>if<space>not<space>name.startswith<openparen><quote>fme_<quote><closeparen><space>and<space>not<space>name.startswith<openparen><quote>_mcp_<quote><closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>val<space>=<space>feature.getAttribute<openparen>name<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>if<space>val<space>is<space>not<space>None:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>attrs<openbracket>name<closebracket><space>=<space>str<openparen>val<closeparen><lf><lf><space><space><space><space><space><space><space><space>payload<space>=<space><opencurly><lf><space><space><space><space><space><space><space><space><space><space><space><space><quote>jsonrpc<quote>:<space><quote>2.0<quote><comma><lf><space><space><space><space><space><space><space><space><space><space><space><space><quote>method<quote>:<space><quote>fme_feature_event<quote><comma><lf><space><space><space><space><space><space><space><space><space><space><space><space><quote>params<quote>:<space><opencurly><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><quote>action<quote>:<space>action<comma><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><quote>feature_type<quote>:<space>feature_type<comma><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><quote>attributes<quote>:<space>attrs<comma><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><quote>timestamp<quote>:<space>time.time<openparen><closeparen><comma><lf><space><space><space><space><space><space><space><space><space><space><space><space><closecurly><comma><lf><space><space><space><space><space><space><space><space><closecurly><lf><lf><space><space><space><space><space><space><space><space>if<space>self.connected<space>and<space>self.sock:<lf><space><space><space><space><space><space><space><space><space><space><space><space>try:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>msg<space>=<space><openparen>json.dumps<openparen>payload<closeparen><space>+<space><quote><backslash>n<quote><closeparen>.encode<openparen><quote>utf-8<quote><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>self.sock.sendall<openparen>msg<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>status<space>=<space><quote>AI_CONNECTED<quote><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>resp<space>=<space>f<quote>Sent<space>to<space>AI<space>Agent<space>on<space>port<space><opencurly>self.port<closecurly><quote><lf><space><space><space><space><space><space><space><space><space><space><space><space>except<space>Exception<space>as<spa